# Supabase Credentials (from settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Credentials (from Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Twilio Credentials (from Twilio Console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
# Optional: If using Twilio Verify API for phone OTP login
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Resend Credentials (from resend.com API Keys)
RESEND_API_KEY=your_resend_api_key
RESEND_SENDER_EMAIL=your_resend_sender_email

# Mapbox Token (from account.mapbox.com)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# OpenAI Credentials (from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key
